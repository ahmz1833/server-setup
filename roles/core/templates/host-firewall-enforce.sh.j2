#!/bin/bash
# Ansible managed: Continuous HOST-FIREWALL chain enforcement daemon
set -euo pipefail

INTERVAL="${HOST_FIREWALL_INTERVAL:-{{ core_firewall_enforce_interval | default(300) }}}"
# Chains kept ahead of HOST-FIREWALL when present
PRE_CHAINS="{{ core_firewall_pre_chains | default([]) | join(' ') }}"

enforce() { # $1=iptables|ip6tables
  local ipt=$1 want="" c i=2
  for c in $PRE_CHAINS; do
    if $ipt -w -S "$c" >/dev/null 2>&1; then want="$want $c"; fi
  done
  want="$want HOST-FIREWALL"
  # INPUT rule N is line N+1 of -S (line 1 is the policy)
  for c in $want; do
    if ! $ipt -w -S INPUT | sed -n "${i}p" | grep -qx -- "-A INPUT -j $c"; then
      for c in $want; do while $ipt -w -D INPUT -j "$c" 2>/dev/null; do :; done; done
      i=1
      for c in $want; do $ipt -w -I INPUT "$i" -j "$c"; i=$((i + 1)); done
      return
    fi
    i=$((i + 1))
  done
}

while true; do
  enforce iptables || true
{% if core_enable_ipv6 | default(false) | bool %}
  enforce ip6tables || true
{% endif %}
  sleep "$INTERVAL"
done
