# Managed by Ansible
# Routes access logs to per-location files based on $endpoint_name, which is set
# in each location block. Unlike per-location access_log directives, this works
# even when request processing ends in another context (e.g. error_page redirects).

{% for site in nginx_sites if site.locations | default([]) | selectattr('log_prefix', 'defined') | list | length > 0 %}
{% set site_key = site.domain | replace('.', '_') | replace('-', '_') %}
{% set names = [site.domain] + (site.aliases | default([])) %}
{% set split_locations = site.locations | default([]) | selectattr('log_prefix', 'defined') | list %}
map $server_name$endpoint_name ${{ site_key }}_log_default {
    default 1;
{% for name in names %}
{% for loc in split_locations %}
    {{ name }}{{ loc.path }} 0;
{% endfor %}
{% endfor %}
}
{% for loc in split_locations %}
{% set prefix_key = loc.log_prefix | replace('-', '_') | replace('.', '_') %}
map $server_name$endpoint_name ${{ site_key }}_log_{{ prefix_key }} {
    default 0;
{% for name in names %}
    {{ name }}{{ loc.path }} 1;
{% endfor %}
}
{% endfor %}

{% endfor %}
