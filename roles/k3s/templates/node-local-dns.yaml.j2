# Ansible managed: Do not edit manually.
# NodeLocalDNSCache deployed by the k3s role.
#   kubelet --cluster-dns = {{ k3s_node_local_dns_ip }}  (config.yaml kubelet-arg)
#   cluster domain queries -> CoreDNS at {{ k3s_node_local_dns_kube_dns_ip }}
#   everything else        -> {{ k3s_node_local_dns_upstream | default([]) | join(' ') if (k3s_node_local_dns_upstream | default([]) | length > 0) else 'host /etc/resolv.conf' }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: node-local-dns
  namespace: kube-system
  labels:
    kubernetes.io/cluster-service: "true"
    addonmanager.kubernetes.io/mode: Reconcile
---
apiVersion: v1
kind: Service
metadata:
  name: node-local-dns
  namespace: kube-system
  labels:
    k8s-app: node-local-dns
    kubernetes.io/cluster-service: "true"
spec:
  clusterIP: None
  ports:
    - name: metrics
      port: 9253
      protocol: TCP
      targetPort: 9253
  selector:
    k8s-app: node-local-dns
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: node-local-dns
  namespace: kube-system
  labels:
    addonmanager.kubernetes.io/mode: Reconcile
data:
  Corefile: |
    {{ k3s_cluster_domain | default('cluster.local') }}:53 {
        errors
        cache {
                success 9984 30
                denial 9984 5
        }
        reload
        loop
        bind {{ k3s_node_local_dns_ip }}
        forward . {{ k3s_node_local_dns_kube_dns_ip }} {
                force_tcp
        }
        prometheus :9253
        health {{ k3s_node_local_dns_ip }}:8080
    }
    in-addr.arpa:53 {
        errors
        cache 30
        reload
        loop
        bind {{ k3s_node_local_dns_ip }}
        forward . {{ k3s_node_local_dns_kube_dns_ip }} {
                force_tcp
        }
        prometheus :9253
    }
    ip6.arpa:53 {
        errors
        cache 30
        reload
        loop
        bind {{ k3s_node_local_dns_ip }}
        forward . {{ k3s_node_local_dns_kube_dns_ip }} {
                force_tcp
        }
        prometheus :9253
    }
    .:53 {
        errors
        cache 30
        reload
        loop
        bind {{ k3s_node_local_dns_ip }}
        forward . {% if k3s_node_local_dns_upstream | default([]) | length > 0 %}{{ k3s_node_local_dns_upstream | join(' ') }}{% else %}__PILLAR__UPSTREAM__STATIC__DNS__{% endif %} {
                policy round_robin
                health_check 5s domain .
        }
        prometheus :9253
    }
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: node-local-dns
  namespace: kube-system
  labels:
    k8s-app: node-local-dns
    kubernetes.io/cluster-service: "true"
    addonmanager.kubernetes.io/mode: Reconcile
spec:
  updateStrategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 10%
  selector:
    matchLabels:
      k8s-app: node-local-dns
  template:
    metadata:
      labels:
        k8s-app: node-local-dns
      annotations:
        prometheus.io/port: "9253"
        prometheus.io/scrape: "true"
    spec:
      priorityClassName: system-node-critical
      serviceAccountName: node-local-dns
      hostNetwork: true
      dnsPolicy: Default
      tolerations:
        - key: CriticalAddonsOnly
          operator: Exists
        - effect: NoExecute
          operator: Exists
        - effect: NoSchedule
          operator: Exists
      containers:
        - name: node-cache
          image: "{{ k3s_node_local_dns_image_repo }}:{{ k3s_node_local_dns_image_tag }}"
          imagePullPolicy: IfNotPresent
          resources:
            requests:
              cpu: 25m
              memory: 15Mi
          args:
            - -localip
            - {{ k3s_node_local_dns_ip }}
            - -conf
            - /etc/coredns/Corefile.base
          securityContext:
            capabilities:
              add:
                - NET_ADMIN
          ports:
            - containerPort: 53
              name: dns
              protocol: UDP
            - containerPort: 53
              name: dns-tcp
              protocol: TCP
            - containerPort: 9253
              name: metrics
              protocol: TCP
          livenessProbe:
            httpGet:
              host: {{ k3s_node_local_dns_ip }}
              path: /health
              port: 8080
            initialDelaySeconds: 60
            timeoutSeconds: 5
          volumeMounts:
            - mountPath: /run/xtables.lock
              name: xtables-lock
            - mountPath: /etc/coredns
              name: config-volume
      volumes:
        - name: xtables-lock
          hostPath:
            path: /run/xtables.lock
            type: FileOrCreate
        - name: config-volume
          configMap:
            name: node-local-dns
            items:
              - key: Corefile
                path: Corefile.base
